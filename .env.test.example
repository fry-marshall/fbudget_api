NODE_ENV=
PORT=

DATABASE_URL=postgresql://user:password@host:port/db

# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# THROTTLE_LIMIT defaults to 1000 in test: the e2e suites share one IP

# GOOGLE_CLIENT_ID and MAIL_* are optional in test: Google and mail services are mocked
