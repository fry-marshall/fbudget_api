NODE_ENV=
PORT=

DATABASE_URL=postgresql://user:password@host:port/db

# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Max requests per IP on /auth/email and /auth/verify-otp, TTL in ms
THROTTLE_TTL=60000
THROTTLE_LIMIT=5

# Google OAuth client ID, used to verify the idToken sent by the mobile app
GOOGLE_CLIENT_ID=

# SMTP server used to send OTP codes
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
